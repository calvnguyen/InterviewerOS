# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Publishable key (safe to expose client-side, formerly "anon key")
# Supabase Dashboard → Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-side only, never expose to client, formerly "service_role key")
# Supabase Dashboard → Settings → API Keys → Reveal
SUPABASE_SECRET_KEY=

# Direct database URI — used by seed.js to create tables
# Supabase Dashboard → Settings → Database → Connection string → URI (Session mode, port 5432)
DATABASE_URL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Enable Gmail API and add scope: https://www.googleapis.com/auth/gmail.readonly
#
# Configure in Supabase Dashboard → Authentication → Providers → Google
# Add Supabase callback URL to Google OAuth client Authorized redirect URIs:
#   https://<your-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=